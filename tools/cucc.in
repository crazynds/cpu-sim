#!/usr/bin/env python3
"""cucc: nvcc replacement for the CPU SIMT device.

Compiles unmodified CUDA sources into a native program whose kernels run on
the CPU, each warp in AVX-512 lanes:

  device side:  clang (CUDA, our headers) -> per-thread IR -> cpusim-devc
                -> warp code (.o) -> shared object -> "fatbin"
  host side:    clang (CUDA host) with the fatbin embedded -> .o
  link:         host objects + libcudart (ours)

Usage mirrors nvcc for the common cases:
  cucc [-c] [-o out] [-I dir] [-D def] [-std=c++20] [-O3] [-fmad=false] [-fopenmp] [-Xcompiler a,b]
       [-arch=sm_XX] [--keep] [--no-specialize] [-v] files... [-l lib] [-L dir]

The kernels are also compiled for each block shape that is a constant at a
launch in the source (`k<<<grid, 128>>>`), in parallel, and those objects go
into the fatbin: at run time a launch with one of those shapes needs no JIT.
--no-specialize leaves every shape to the JIT.
"""
import concurrent.futures
import re
import os
import shlex
import struct
import subprocess
import sys
import tempfile
import time

CLANG = "@CPUSIM_CLANG@"
DEVC = "@CPUSIM_DEVC@"
INCLUDE = "@CPUSIM_INCLUDE_DIR@"
CUDA_STUB = "@CPUSIM_CUDA_STUB@"
LIBDIR = "@CPUSIM_LIB_DIR@"
FATBIN_MAGIC = b"CPUSIMFB"

# Clang's CUDA mode without the NVIDIA SDK: our headers, and an SDK version
# passed straight to cc1 (the driver drops it under -nocudalib).
CUDA_FLAGS = [
    "-x", "cuda", "--cuda-gpu-arch=sm_70", "--cuda-path=" + CUDA_STUB,
    "-nocudainc", "-nocudalib", "-Wno-unknown-cuda-version",
    "-Xclang", "-target-sdk-version=12.5",
    # What nvcc defines: code picks its CUDA branch by these (clang defines
    # __CUDACC__ only in the SDK headers that -nocudainc leaves out).
    # __CPUSIM__ tells cucc apart from nvcc.
    "-D__CUDACC__", "-D__NVCC__", "-D__CUDACC_VER_MAJOR__=12", "-D__CUDACC_VER_MINOR__=5",
    "-D__CUDACC_VER_BUILD__=0", "-D__CPUSIM__=1",
    "-I", INCLUDE, "-include", "cuda_runtime.h",
]


def die(msg):
    sys.stderr.write("cucc: error: " + msg + "\n")
    sys.exit(1)


class Options:
    def __init__(self):
        self.output = None
        self.compile_only = False
        self.keep = False
        self.verbose = False
        self.opt = "-O3"
        self.std = "-std=c++17"
        self.fmad = True
        self.cpp = []        # -I, -D, -U
        self.sources = []    # .cu / .cpp
        self.inputs = []     # .o / .a passed to the linker
        self.link = []       # -l, -L
        self.host = []       # host-only flags (-fopenmp)
        self.specialize = True  # compile the constant block shapes ahead of time
        self.mcpu = "native"  # the device code targets this machine's CPU (--mcpu=znver4 etc. for another)


def parse(argv):
    o = Options()
    i = 0
    while i < len(argv):
        a = argv[i]

        def value():
            nonlocal i
            if i + 1 >= len(argv):
                die(a + " needs a value")
            i += 1
            return argv[i]

        if a == "-o":
            o.output = value()
        elif a == "-c":
            o.compile_only = True
        elif a in ("--keep", "-keep"):
            o.keep = True
        elif a == "--no-specialize":
            o.specialize = False
        elif a == "-v":
            o.verbose = True
        elif a.startswith("-O"):
            o.opt = a
        elif a.startswith("-std="):
            o.std = a
        elif a.startswith("--std="):
            o.std = "-std=" + a[6:]
        elif a in ("-fmad=false", "--fmad=false"):
            o.fmad = False
        elif a in ("-fmad=true", "--fmad=true"):
            o.fmad = True
        elif a in ("-I", "-D", "-U"):
            o.cpp += [a, value()]
        elif a[:2] in ("-I", "-D", "-U"):
            o.cpp.append(a)
        elif a == "-l" or a == "-L":
            o.link += [a, value()]
        elif a[:2] in ("-l", "-L"):
            o.link.append(a)
        elif a.startswith("--mcpu="):
            o.mcpu = a.split("=", 1)[1]
        elif a.startswith(("-arch", "--gpu-architecture", "-gencode", "--generate-code", "-code")):
            if "=" not in a and a in ("-arch", "--gpu-architecture", "-gencode", "--generate-code", "-code"):
                value()
        elif a == "-fopenmp":
            o.host.append("-fopenmp")
        elif a in ("-Xcompiler", "--compiler-options") or a.startswith(("-Xcompiler=", "--compiler-options=")):
            # Host compiler options, comma separated as in nvcc.
            v = a.split("=", 1)[1] if "=" in a else value()
            o.host += [f for f in v.split(",") if f]
        elif a in ("-lineinfo", "-g", "-G", "--use_fast_math", "-use_fast_math", "-Wno-deprecated-gpu-targets"):
            pass
        elif a in ("--expt-relaxed-constexpr", "-expt-relaxed-constexpr", "--extended-lambda", "-extended-lambda",
                   "--expt-extended-lambda", "-expt-extended-lambda"):
            pass  # clang's CUDA mode does both by default (constexpr and lambdas take their callers' side)
        elif a in ("--default-stream", "-default-stream") or a.startswith(("--default-stream=", "-default-stream=")):
            # per-thread or legacy: one host thread per program in practice; the
            # runtime's default stream already behaves as both for it.
            v = a.split("=", 1)[1] if "=" in a else value()
            if v not in ("per-thread", "legacy", "null"):
                die("--default-stream takes per-thread, legacy or null")
        elif a in ("-x",):
            value()
        elif a.startswith("-"):
            die("unsupported option " + a)
        elif a.endswith((".cu", ".cpp", ".cc", ".cxx", ".c")):
            o.sources.append(a)
        elif a.endswith((".o", ".a", ".so")):
            o.inputs.append(a)
        else:
            die("unknown input " + a)
        i += 1
    if not o.sources and not o.inputs:
        die("no input files")
    return o


def run(cmd, o):
    if not run_quiet(cmd, o):
        sys.exit(1)


def build_fatbin(manifest_path, so_path, bc_path, out_path, specialized=()):
    """header | manifest | shared object | bitcode | table of specialized
    objects (block x, y, z, 0, offset, size) | those objects
    (src/device/kernel_abi.h)."""
    manifest = open(manifest_path, "rb").read()
    obj = open(so_path, "rb").read()
    bitcode = open(bc_path, "rb").read() if bc_path else b""
    # "cpusim-module <abi>": the version the device compiler generated code for.
    abi = int(manifest.split(b"\n", 1)[0].split()[1])
    align = lambda n, a: (n + a - 1) // a * a
    header_size = 8 + 4 + 4 + 8 * 8
    manifest_off = header_size
    obj_off = align(manifest_off + len(manifest), 4096)
    bc_off = align(obj_off + len(obj), 64)
    table_off = align(bc_off + len(bitcode), 64)
    # (shape, path): shape is (x, y, z), or (0, 0, 0, class) for a class of shapes.
    objects = [(tuple(shape) + (0,) * (4 - len(shape)), open(path, "rb").read()) for shape, path in specialized]
    entries, offset = [], align(table_off + 32 * len(objects), 64)
    for shape, data in objects:
        entries.append(struct.pack("<4I2Q", shape[0], shape[1], shape[2], shape[3], offset, len(data)))
        offset = align(offset + len(data), 64)
    header = FATBIN_MAGIC + struct.pack("<II8Q", abi, 0, manifest_off, len(manifest), obj_off, len(obj),
                                        bc_off if bitcode else 0, len(bitcode), table_off if objects else 0,
                                        len(objects))
    data = header + manifest
    data += b"\0" * (obj_off - len(data)) + obj
    if bitcode:
        data += b"\0" * (bc_off - len(data)) + bitcode
    if objects:
        data += b"\0" * (table_off - len(data)) + b"".join(entries)
        for (shape, obj_data), entry in zip(objects, entries):
            off = struct.unpack("<4I2Q", entry)[4]
            data += b"\0" * (off - len(data)) + obj_data
    open(out_path, "wb").write(data)


# The block shapes of the launches whose shape is a compile-time constant:
# clang lowers k<<<grid, block>>> to __cudaPushCallConfiguration(grid.x | y << 32,
# grid.z, block.x | block.y << 32, block.z, ...); after -O2 a constant block
# shows as two integer literals.
PUSH_CONFIG = re.compile(r"@__cudaPushCallConfiguration\(i64 [^,]+, i32 [^,]+, i64 (?:noundef )?(\d+), "
                         r"i32 (?:noundef )?(\d+)")
MAX_SPECIALIZED = 32


def launch_shapes(src, common, o, base):
    ll = base + ".host.ll"
    run([CLANG] + common + o.host + ["--cuda-host-only", "-O2", "-S", "-emit-llvm", "-o", ll, src], o)
    shapes = set()
    for xy, z in PUSH_CONFIG.findall(open(ll).read()):
        x, y, z = int(xy) & 0xFFFFFFFF, int(xy) >> 32, int(z)
        if 0 < x * y * z <= 1024:
            shapes.add((x, y, z))
    return sorted(shapes)[:MAX_SPECIALIZED]


def shape_class(x, y, z):
    """cpusim_shape_class (src/device/kernel_abi.h): the class of block shapes
    whose specialized code is the same, 0 for none."""
    if y == 1 and z == 1:
        if x % 128 == 0:
            return 1
        if x % 32 == 0:
            return 2
    return 0


def warp_size():
    """CPUSIM_WARP_SIZE: threads per warp the program is compiled for (16, 32
    as in CUDA, or 64 as on AMD GPUs). Fixed at compile time: the kernels'
    warpSize, lane ids, ballots and shuffles depend on it."""
    w = os.environ.get("CPUSIM_WARP_SIZE", "32")
    if w not in ("16", "32", "64"):
        die("CPUSIM_WARP_SIZE must be 16, 32 or 64, not %r" % w)
    return int(w)


def run_quiet(cmd, o):
    """Like run(), but returns whether it worked instead of exiting."""
    if o.verbose:
        sys.stderr.write("+ " + " ".join(shlex.quote(c) for c in cmd) + "\n")
    start = time.monotonic()
    code = subprocess.run(cmd).returncode
    if o.verbose:
        sys.stderr.write("  (%s: %.1f s)\n" % (os.path.basename(cmd[0]), time.monotonic() - start))
    if code < 0:  # killed by a signal: a crash says nothing by itself
        sys.stderr.write("cucc: %s died (signal %d)\n" % (os.path.basename(cmd[0]), -code))
    return code == 0


def link_kernels(objs, so, o):
    # libmvec/libm: the vector and scalar math the device code calls;
    # libcpusim_tensor: the native tensor routines. Only recorded as
    # dependencies when used.
    return [CLANG, "-shared", "-nostdlib", "-o", so] + list(objs) + ["-Wl,--as-needed", "-lmvec", "-lm", "-L", LIBDIR,
            "-lcpusim_tensor", "-Wl,-rpath," + LIBDIR]


def list_kernels(bc, o):
    """The kernels of the device bitcode, and whether they must be compiled
    in one module (device functions whose address is taken)."""
    r = subprocess.run([DEVC, bc, "--list"], capture_output=True, text=True)
    if r.returncode != 0:
        return [], True
    kernels = [l.split(" ", 1)[1] for l in r.stdout.splitlines() if l.startswith("kernel ")]
    return kernels, "together" in r.stdout.splitlines()


def merge_manifests(parts, out):
    """One manifest from the per-kernel ones: the first one's header and
    symbol lines, every one's kernel lines."""
    lines = []
    for i, part in enumerate(parts):
        for line in open(part).read().splitlines():
            if i == 0 or line.startswith("kernel "):
                lines.append(line)
    open(out, "w").write("\n".join(lines) + "\n")


def compile_cu(src, obj_out, o, tmp):
    base = os.path.join(tmp, os.path.splitext(os.path.basename(src))[0])
    # "on" fuses a*b+c into fmuladd in the front end, per expression, before the
    # kernel is specialized; with "fast" the backend decides per basic block, so
    # the JIT and generic variants could round differently (tests/cuda/repro.cu).
    contract = ["-ffp-contract=on" if o.fmad else "-ffp-contract=off"]
    common = CUDA_FLAGS + [o.std] + o.cpp + contract + ["-D__CPUSIM_WARP_SIZE__=%d" % warp_size()]

    # Device: per-thread IR, unoptimized but with full metadata (O2 front end, no passes).
    run([CLANG] + common + ["--cuda-device-only", "-O2", "-Xclang", "-disable-llvm-passes",
                            "-emit-llvm", "-c", src, "-o", base + ".dev.bc"], o)
    devc = [DEVC, base + ".dev.bc", "-o", base + ".dev.o", "--manifest", base + ".manifest", "--mcpu", o.mcpu]
    if os.environ.get("CPUSIM_SPECIALIZE"):  # experiments: one block shape for every kernel
        devc += ["--specialize", os.environ["CPUSIM_SPECIALIZE"]]
    if o.keep:
        devc += ["--emit-ll", base + ".warp.ll", "--emit-scalar-ll", base + ".thread.ll", "--emit-raw-ll", base + ".raw.ll",
                 "--emit-asm", base + ".warp.s"]
    # The generic module and one per constant block shape. Each kernel of
    # each module is compiled by a cpusim-devc of its own, all of them at
    # once (as many as there are cores), and a module's objects are linked
    # into its shared object: the code is the same as from one process per
    # module, which built the kernels one after the other (minutes for files
    # with many large kernels). One process per module when the kernels
    # must stay together (function pointers) or the intermediate files are
    # kept.
    shapes = launch_shapes(src, common, o, base) if o.specialize and not os.environ.get("CPUSIM_SPECIALIZE") else []
    kernels, together = list_kernels(base + ".dev.bc", o)
    apart = len(kernels) > 1 and not together and not o.keep
    # A shape of a class (shape_class) gets the class's module, shared with
    # the other shapes of the class, for its kernels without barriers, and
    # its own module for those with (their whole-block variants need it).
    modules = {None: (base + ".dev.o", base + ".manifest", base + ".kernels.so", devc[6:])}
    for x, y, z in shapes:
        stem = "%s.%dx%dx%d" % (base, x, y, z)
        c = shape_class(x, y, z) if warp_size() >= 32 else 0
        modules[(x, y, z)] = (stem + ".o", stem + ".manifest", stem + ".so",
                              ["--mcpu", o.mcpu, "--specialize", "%d,%d,%d" % (x, y, z)] + (["--barriers-only"] if c else []))
        if c and (0, 0, 0, c) not in modules:
            cstem = "%s.class%d" % (base, c)
            modules[(0, 0, 0, c)] = (cstem + ".o", cstem + ".manifest", cstem + ".so",
                                     ["--mcpu", o.mcpu, "--specialize-class", str(c), "--no-barriers"])
    parts = {}
    for shape, (obj, manifest, so, extra) in modules.items():
        if apart:
            parts[shape] = [("%s.k%d.o" % (obj, i), "%s.k%d" % (manifest, i), ["--kernels", k]) for i, k in enumerate(kernels)]
        else:
            parts[shape] = [(obj, manifest, [])]
    # The cores shared out: each cpusim-devc also generates code in threads.
    jobs = sum(len(p) for p in parts.values())
    os.environ["CPUSIM_DEVC_THREADS"] = str(max(1, (os.cpu_count() or 4) // jobs))
    with concurrent.futures.ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as pool:
        compiled = {shape: [pool.submit(run_quiet, [DEVC, base + ".dev.bc", "-o", po, "--manifest", pm] + modules[shape][3] + pk, o)
                            for po, pm, pk in parts[shape]]
                    for shape in modules}

        def link(shape):
            if not all(f.result() for f in compiled[shape]):
                return False
            obj, manifest, so, _ = modules[shape]
            if apart:
                merge_manifests([pm for _, pm, _ in parts[shape]], manifest)
            return run_quiet(link_kernels([po for po, _, _ in parts[shape]], so, o), o)

        done = {shape: pool.submit(link, shape) for shape in modules}
    if not done[None].result():
        sys.exit(1)
    specialized = []
    for shape in modules:
        if shape is None:
            continue
        if done[shape].result():
            specialized.append((shape, modules[shape][2]))
        else:  # the JIT will try again at run time
            sys.stderr.write("cucc: warning: no ahead-of-time code for block %s\n" % (shape,))
    build_fatbin(base + ".manifest", base + ".kernels.so", base + ".dev.bc", base + ".fatbin", specialized)

    # Host: the fatbin goes into .nv_fatbin and is registered at startup.
    run([CLANG] + common + o.host + ["--cuda-host-only", o.opt, "-Xclang", "-fcuda-include-gpubinary",
                            "-Xclang", base + ".fatbin", "-c", src, "-o", obj_out], o)


def main():
    o = parse(sys.argv[1:])
    if o.compile_only and o.output and len(o.sources) > 1:
        die("-o with -c needs a single source")
    tmp = tempfile.mkdtemp(prefix="cucc-")
    try:
        objects = []
        for src in o.sources:
            if o.compile_only:
                obj = o.output or os.path.splitext(os.path.basename(src))[0] + ".o"
            else:
                obj = os.path.join(tmp, os.path.basename(src) + ".o")
            if src.endswith(".cu"):
                compile_cu(src, obj, o, tmp)
            elif src.endswith(".c"):  # C, as nvcc hands it to the host compiler
                run([CLANG, "-x", "c", "-c", o.opt, "-I", INCLUDE] + o.cpp + o.host + [src, "-o", obj], o)
            else:
                run([CLANG, "-c", o.std, o.opt, "-I", INCLUDE] + o.cpp + o.host + [src, "-o", obj], o)
            objects.append(obj)
        if o.compile_only:
            return
        out = o.output or "a.out"
        if "-fopenmp" in o.host:  # OpenMP: clang's libomp, found next to clang at run time too
            omp_lib = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(CLANG))), "lib")
            o.link = ["-fopenmp", "-L", omp_lib, "-Wl,-rpath," + omp_lib] + o.link
        run([CLANG, "-o", out] + objects + o.inputs + ["-L", LIBDIR, "-Wl,-rpath," + LIBDIR] + o.link
            + ["-lcpusim_cudart", "-lpthread"], o)
    finally:
        if o.keep:
            sys.stderr.write("cucc: intermediate files kept in " + tmp + "\n")
        else:
            subprocess.run(["rm", "-rf", tmp])


if __name__ == "__main__":
    main()
